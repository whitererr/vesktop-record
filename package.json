{
  "name": "vesktop-call-recorder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Experimental local call recorder userplugin for Vencord on Vesktop",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "test:audio": "tsx scripts/audio-smoke.ts",
    "prepare:vencord": "node scripts/vencord.mjs prepare",
    "build": "node scripts/vencord.mjs build",
    "typecheck": "tsc --noEmit && node scripts/vencord.mjs typecheck",
    "watch": "node scripts/vencord.mjs watch",
    "bot": "tsx companion/main.ts"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.28.1",
    "playwright": "1.64.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
